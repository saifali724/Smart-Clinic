# Copy the lines you need into .env (never commit .env)

# CNIC OCR
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
PORT=5001

# Forgot password — email sender (Gmail app password, see SETUP-PASSWORD-RESET.md)
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your16letterapppassword
# optional
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=your.gmail@gmail.com

# Forgot password — Firebase service key file (default: serviceAccountKey.json next to server.js)
# FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json
