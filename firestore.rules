rules_version = '2';

// DEVELOPMENT RULES — EVERYTHING IS OPEN
// ─────────────────────────────────────
// Anyone can read and write every collection (patients, users, visits, vitals …),
// with or without logging in. This is only for building and demoing the project.
//
// They switch themselves OFF after 31 March 2027 (Firebase then blocks everything).
// Change the date below if you need more time.
//
// Before real patients use the app, replace this with proper rules
// (only logged-in doctors can read/write).
//
// Paste into: Firebase Console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2027, 3, 31);
    }
  }
}
